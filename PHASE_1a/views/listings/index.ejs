<% layout("/layouts/boilerplate")%>
<body>
    <h3 style="padding-left: 0.6rem; padding-bottom: 0.2rem;">All Listings</h3>
    <!-- <form action="/listings/new" method="get"><button>Create New Listing</button></form> button ki need nhi kyu navbar mei chle gye -->

    <div class="row row-cols-lg-4  row-cols-md-2 row-cols-sm-1 row-cols-1   ">
        <% for(let listing of allListings){%>
        <a href="/listings/<%=listing._id%>" class="listing-list">
        <div class="card" >
        <img src="<%=listing.image.url%>" class="card-img-top" style="height:14rem"  alt="place">
        <div class="card-img-overlay">
        <h5 class="card-title">*</h5>
        </div>
        <div class="card-body">
            <p class="card-text"><b><%=listing.title %></b> <br>
            &#8377; <%=listing.price.toLocaleString("en-IN") %> /night
            </p>
        </div>
        </div>
        </a>
        <%}%>
    </div>

</body>
