<% layout("/layouts/boilerplate")%>
<body>

<div class="row">

    <div class="col-md-8 offset-3 mb-3">
    <h3>Listing Details</h3>
    </div>

    <div class="col-md-6 offset-3 show-card">
    <div class="card ">
        <img src="<%=listing.image.url%>" class="card-img-top" style="height:14rem"  alt="place">
        <div class="card-img-overlay">
        <h5 class="card-title">*</h5>
        </div>
        <div class="card-body">
            <p><b><%=listing.title%></b></p>
            <p><%=listing.description %></p>
            <p>&#8377; <%=listing.price.toLocaleString("en-IN") %></p>
            <p><%=listing.location %></p>
            <p><%=listing.country %></p>
        </div>
    </div>
    </div>
    <div class="btns " >
        <a href="/listings/<%= listing._id%>/edit"  class="btn btn-outline add-btn col-md-1 edit-btn" >
            Edit
        </a>
        
        <form action="/listings/<%=listing._id%>?_method=DELETE" method="post">
            <button class="btn btn-outline add-btn  delete-btn">Delete</button></a>
        </form>
    </div>
    </div>
        <br>
    </body>
